{
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch . server.js",
    "start": "node server.js",
    "db:init": "node database/init.js",
    "db:check": "node database/check.js",
    "db:reset": "mysql -u $MYSQL_USER -p$MYSQL_PASS -e 'DROP DATABASE IF EXISTS rank; CREATE DATABASE rank;' && npm run db:init",
    "setup": "npm install && npm run db:reset"
  },
  "imports": {
    "#database": "./database/connection.js",
    "#*": "./src/*"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.5.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.3",
    "nodemon": "^3.1.7"
  }
}
